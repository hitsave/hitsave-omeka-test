# OmekaDipViewer Wasabi settings — Omeka stack only (not hitsave-archiver ingest).
# Copy to dip-s3.yaml (gitignored) and render dip-s3.config.php:
#   python3 scripts/shell/render-dip-s3-config.py

# Optional default when media only has package_storage_prefix (no s3:// URI).
# Normally the bucket comes from dip_wasabi_uri on each DIP media (IAM allows listed buckets).
# bucket: hitsave-press-material
endpoint: https://s3.us-east-2.wasabisys.com
region: us-east-2

# Read-only Omeka user keys (copy dip-s3-credentials.yaml.example → dip-s3-credentials.yaml).
credentials_file: dip-s3-credentials.yaml
